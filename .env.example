# Required. Any long random string; the same value is used by both services.
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
INGEST_API_KEY=change-me

# Browser origins allowed to call Ingest directly (comma-separated). Cointrail's server talks to
# Ingest over the Docker network, so the default is fine unless you host the UI elsewhere.
ALLOWED_ORIGINS=http://localhost:8501

# --- Optional: only if you connect real data sources (see README "Using your own data") ---
# PDF statement passwords, one per bank (comma-separate if you have several):
# PDF_PASSWORD_HDFC=
# PDF_PASSWORD_ICICI=
# PDF_PASSWORD_HSBC_CC=
# PDF_PASSWORD_HSBC_ACCOUNT=
# PDF_PASSWORD_SBI=
# PDF_PASSWORD_AXIS=

# Alerts (any one): Telegram, ntfy, or a generic webhook
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# NTFY_URL=
# INGEST_ALERT_WEBHOOK=

# Email addresses whose "SMS Backup & Restore" attachments should be auto-imported (comma-separated)
# SMS_BACKUP_SENDERS=you@example.com
